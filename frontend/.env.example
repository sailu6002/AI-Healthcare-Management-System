# Base URL for the Spring Boot backend.
#
# Leave empty during local development: requests are sent to the Vite dev
# server on the same origin and proxied to the backend (see vite.config.js).
#
# Set this only for a build deployed to a different origin than the backend,
# e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
